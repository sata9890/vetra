PUSHER_APP_ID=""
PUSHER_SECRET=""

# Feature Flags
VIDEO_CALLS="false"
STRIPE_PRODUCTION="false"
CREDITS_ENABLED="true"
PLATFORM_FEE_PCT="5"
OWNER_HANDLE="vetra"

# Optional
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
